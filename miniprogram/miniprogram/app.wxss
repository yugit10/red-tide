/* 全局样式:海洋色系 */
page {
  background: #F2F7FA;
  color: #17324A;
  font-size: 30rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}
.container { padding: 24rpx; }
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(11, 58, 91, 0.08);
}
.title { font-size: 40rpx; font-weight: 700; color: #0B3A5B; }
.sub { font-size: 26rpx; color: #6B8496; }
.btn-primary {
  background: #0B3A5B;
  color: #FFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
  margin-top: 16rpx;
}
.btn-primary[disabled] { background: #9DB4C4; color: #F0F4F7; }
.btn-secondary {
  background: #E8F1F8;
  color: #0B3A5B;
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
  margin-top: 16rpx;
}
.preview { width: 100%; border-radius: 20rpx; margin: 20rpx 0; }
.tip { font-size: 26rpx; color: #8A9AA8; }
.big-emoji { font-size: 64rpx; }
