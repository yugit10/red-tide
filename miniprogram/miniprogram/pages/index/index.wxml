<view class="container">
  <view class="card">
    <view class="title">🌊 赤潮快查</view>
    <view class="sub">拍一张海面照片, 三句话告诉您: 什么情况、现在该干什么、该找谁。</view>
  </view>

  <view class="card">
    <block wx:if="{{imgPath}}">
      <image class="preview" src="{{imgPath}}" mode="widthFix" />
    </block>
    <button class="btn-primary" bindtap="choosePhoto">📷 拍一张 / 从相册选</button>
    <button class="btn-primary" bindtap="startAnalyze" disabled="{{!imgPath || busy}}">
      {{busy ? '分析中…' : (imgPath ? '✅ 开始看风险' : '请先选择照片')}}
    </button>
    <view wx:if="{{status}}" class="tip" style="margin-top:16rpx;text-align:center;">{{status}}</view>
    <view wx:if="{{err}}" class="tip" style="margin-top:16rpx;color:#C00000;">{{err}}</view>
  </view>

  <view class="card">
    <view class="sub">💡 拍照提示: 对着海面拍, 尽量拍到整片水面, 避免只拍天空或沙滩。</view>
    <view class="sub" style="margin-top:8rpx;">❌ 桌面、地面、文档、人像等无关照片会被自动拦下。</view>
  </view>
</view>
